+with zipfile.ZipFile('data/yahoo.zip') as archive:
+    archive.extractall('data')
+print('Running original Yahoo offline demonstration on all supplied A1 series', flush=True)
+try:
+    subprocess.run([sys.executable, 'yahoo_demo.py', '--res_dir', str(out/'figures'), '--pattern_dir', str(out/'patterns')], check=True)
