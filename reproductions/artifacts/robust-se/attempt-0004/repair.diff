diff --git a/reproduce.R b/reproduce.R
new file mode 100644
index 0000000..e4d6f3c
--- /dev/null
+++ b/reproduce.R
@@ -0,0 +1,28 @@
+# AI-written harness: run original Poisson statements and original pre-bootstrap diagnostic.
+# Full original script remains present. No bootstrap counts/seeds are changed.
+options(warn=1)
+dir.create(Sys.getenv("REPRO_RESULTS"),showWarnings=FALSE)
+setwd("/work")
+expr <- parse("DreherJensen.R")
+# Original author statements through seed, excluding only the first full bootstrap invocation.
+for (e in expr) {
+ if (is.call(e) && identical(e[[1]], as.name("<-")) && identical(e[[2]],as.name("IMtest"))) break
+ eval(e, envir=.GlobalEnv)
+}
+# Evaluate original bootstrap function's setup, stopping before its first outer loop.
+# This computes original Dhat without substituting fewer bootstrap draws.
+env <- new.env(parent=.GlobalEnv); env$formula <- form; env$data <- dat; env$B <- 99; env$B2 <- 50
+for (e in as.list(body(bootstrapIM.poisson))[-1]) {
+ if (is.call(e) && identical(e[[1]],as.name("for"))) break
+ eval(e,envir=env)
+}
+model_se <- sqrt(diag(vcov(lm7,complete=FALSE)))
+robust_se <- sqrt(diag(sandwich(lm7)))
+coef <- coef(lm7); keep <- !is.na(coef)
+out <- data.frame(term=names(coef)[keep], estimate=coef[keep], conventional_se=model_se,robust_se=robust_se)
+write.csv(out,file.path(Sys.getenv("REPRO_RESULTS"),"poisson-coefficients.csv"),row.names=FALSE)
+write.csv(data.frame(term=names(env$Dhat),discrepancy=as.numeric(env$Dhat)),file.path(Sys.getenv("REPRO_RESULTS"),"initial-im-diagnostic.csv"),row.names=FALSE)
+writeLines(c(paste("R",getRversion()),paste("Observations",nobs(lm7)),paste("Design columns",ncol(model.matrix(lm7))),paste("Estimable coefficients",sum(keep)),paste("Aliased coefficients",sum(!keep)),paste("Log likelihood",as.numeric(logLik(lm7)))),file.path(Sys.getenv("REPRO_RESULTS"),"measurements.txt"))
+capture.output(sessionInfo(),file=file.path(Sys.getenv("REPRO_RESULTS"),"sessionInfo.txt"))
+cat("Original Poisson specification and pre-bootstrap IM diagnostic completed. Full bootstrap was NOT run.\n")
+print(out[seq_len(min(8,nrow(out))),]); print(env$Dhat)
